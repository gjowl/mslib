batch_name = interhelicalCoordinates 
baseDir    = /home/loiseau/interhelicalCoordinates
pdbDir     = /home/loiseau/nonRedundantPdbs

executable = /home/loiseau/programs/interhelicalCoordinates
output     = $(baseDir)/out/$(pdb_id).out
log        = $(baseDir)/log/$(pdb_id).log
error      = $(baseDir)/err/$(pdb_id).err
stream_output = TRUE
stream_error  = TRUE

inputCsvDir = /home/loiseau/interhelicalCoordinates/inputCsv

#Compute Resources
request_cpus = 1
request_memory = 4GB
request_disk = 1GB
+WantFlocking = TRUE
+WantGlideIn = TRUE

should_transfer_files = YES
transfer_input_files = $(pdbDir)/$(pdb_file)
when_to_transfer_output = ON_EXIT_OR_EVICT
transfer_output_files = $(pdb_id)

Arguments = "$(pdb_file) --outputdir $(pdb_id)"
queue pdb_file,pdb_id from $(inputCsvDir)/submit.csv