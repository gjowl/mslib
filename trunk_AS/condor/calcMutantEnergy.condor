batch_name = calcEnergy_ala
baseDir    = /home/loiseau/calcMutantEnergy

executable = /home/loiseau/programs/calcMutantEnergy
output     = $(baseDir)/out/$(outputDir).out
log        = $(baseDir)/log/$(outputDir).log
error      = $(baseDir)/err/$(outputDir).err
stream_output = TRUE
stream_error  = TRUE

configFile = calcEnergy.config
inputFileDir = /home/loiseau/inputFiles

#Compute Resources
request_cpus = 1
request_memory = 4GB
request_disk = 1GB
+WantFlocking = TRUE
+WantGlideIn = TRUE

should_transfer_files = YES
transfer_input_files = $(baseDir)/$(configFile), $(baseDir)/2023-3-13_ala_pdbs/$(pdb), $(inputFileDir)/helicalAxis.pdb, $(inputFileDir)/69-gly-residue-helix.pdb, $(inputFileDir)/top_all22_prot.inp, $(inputFileDir)/par_all22_prot.inp, $(inputFileDir)/par_hbond_CA_2.txt, $(inputFileDir)/solvpar22.inp, $(inputFileDir)/rotlib_combined_-60_-40.txt, $(inputFileDir)/CENTROIDS_0.5_cutoff-6_byHbond, $(inputFileDir)/TMRULES_byHbond.txt 
when_to_transfer_output = ON_EXIT_OR_EVICT
transfer_output_files = $(outputDir)

Arguments = "--config $(configFile) --outputDir $(outputDir) --pdbFile $(pdb) --Position $(pos1) $(pos2) $(pos3) $(pos4) $(pos5) $(pos6)"
queue outputDir,pdb,pos1,pos2,pos3,pos4,pos5,pos6 from $(baseDir)/ala_input_possible_clashes.csv